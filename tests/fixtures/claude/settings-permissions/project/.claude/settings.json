{
  "permissions": {
    "allow": [
      "*",
      "mcp__*",
      "Bash(npm run test:*)",
      "Read(/src/**)",
      "WebFetch(domain:example.com)",
      "WebFetch(example.net)",
      "mcp__github(issues)"
    ],
    "deny": [
      "Bash",
      "Write",
      "Edit(//etc/secrets/**)",
      "WebFetch(example.org)"
    ],
    "disableBypassPermissionsMode": false,
    "additionalDirectories": [
      "/opt/shared-docs",
      "../vendor-lib"
    ]
  },
  "enableAllProjectMcpServers": true
}
